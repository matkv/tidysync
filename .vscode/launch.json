  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug executable 'tidysync'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=tidysync"]
      },
      "args": ["--api-key", "${env:SYNCTHING_API_KEY}", "watch"],
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "name": "Debug unit tests in executable 'tidysync'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--bin=tidysync"]
      }
    }
  ]
}
